@{
    ViewData["Title"] = "Profile - DevTools Suite";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="fw-bold mb-0">Profile Information</h5>
                </div>
                <div class="card-body">
                    <form id="profileForm">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="displayName" class="form-label">Display Name</label>
                                    <input type="text" class="form-control" id="displayName" value="@User.Identity.Name">
                                    <div class="form-text">This is how your name will appear across the platform</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="email" class="form-label">Email Address</label>
                                    <input type="email" class="form-control" id="email" value="user@example.com" readonly>
                                    <div class="form-text">Contact support to change your email address</div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="jobTitle" class="form-label">Job Title</label>
                                    <input type="text" class="form-control" id="jobTitle" placeholder="e.g., Full Stack Developer">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="company" class="form-label">Company</label>
                                    <input type="text" class="form-control" id="company" placeholder="e.g., Tech Corp Inc.">
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="bio" class="form-label">Bio</label>
                            <textarea class="form-control" id="bio" rows="3" placeholder="Tell us a bit about yourself..."></textarea>
                            <div class="form-text">Brief description for your profile</div>
                        </div>

                        <div class="mb-3">
                            <label for="website" class="form-label">Website</label>
                            <input type="url" class="form-control" id="website" placeholder="https://example.com">
                        </div>

                        <div class="mb-3">
                            <label for="location" class="form-label">Location</label>
                            <input type="text" class="form-control" id="location" placeholder="City, Country">
                        </div>

                        <div class="d-flex justify-content-between">
                            <button type="button" class="btn btn-outline-secondary">Cancel</button>
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Social Links -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="fw-bold mb-0">Social Profiles</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="github" class="form-label">
                                    <i class="fab fa-github me-2"></i>GitHub
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">github.com/</span>
                                    <input type="text" class="form-control" id="github" placeholder="username">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="twitter" class="form-label">
                                    <i class="fab fa-twitter me-2"></i>Twitter
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">twitter.com/</span>
                                    <input type="text" class="form-control" id="twitter" placeholder="username">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="linkedin" class="form-label">
                                    <i class="fab fa-linkedin me-2"></i>LinkedIn
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">linkedin.com/in/</span>
                                    <input type="text" class="form-control" id="linkedin" placeholder="profile">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="website" class="form-label">
                                    <i class="fas fa-globe me-2"></i>Personal Website
                                </label>
                                <input type="url" class="form-control" id="personalWebsite" placeholder="https://">
                            </div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="button" class="btn btn-primary">Save Social Links</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Profile Summary -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body text-center p-4">
                    <div class="avatar-placeholder bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                        <i class="fas fa-user fa-2x text-primary"></i>
                    </div>
                    <h5 class="fw-bold mb-1">@User.Identity.Name</h5>
                    <p class="text-muted mb-2">Full Stack Developer</p>
                    <div class="badge bg-primary mb-3">Pro Plan</div>
                    <p class="text-muted small">Member since January 2024</p>

                    <div class="d-grid gap-2">
                        <button class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-camera me-2"></i>Change Avatar
                        </button>
                    </div>
                </div>
            </div>

            <!-- Account Stats -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0 py-3">
                    <h6 class="fw-bold mb-0">Account Stats</h6>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted">Tools Used</span>
                        <span class="fw-bold">47</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted">Sessions Saved</span>
                        <span class="fw-bold">12</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted">Favorite Tools</span>
                        <span class="fw-bold">3</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">Productivity Score</span>
                        <span class="fw-bold text-primary">85%</span>
                    </div>
                </div>
            </div>

            <!-- Security -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h6 class="fw-bold mb-0">Security</h6>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h6 class="fw-bold mb-1">Two-Factor Authentication</h6>
                            <p class="text-muted small mb-0">Add an extra layer of security</p>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="2faToggle">
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h6 class="fw-bold mb-1">Login Notifications</h6>
                            <p class="text-muted small mb-0">Get alerts for new logins</p>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="loginNotifications" checked>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-3">
                        <a href="/dashboard/security" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-shield-alt me-2"></i>Security Settings
                        </a>
                        <a href="/dashboard/password" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-key me-2"></i>Change Password
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('profileForm').addEventListener('submit', function(e) {
            e.preventDefault();

            // Simulate saving profile
            const submitBtn = this.querySelector('button[type="submit"]');
            const originalText = submitBtn.innerHTML;

            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Saving...';
            submitBtn.disabled = true;

            setTimeout(() => {
                // Show success message
                const alert = document.createElement('div');
                alert.className = 'alert alert-success alert-dismissible fade show mt-3';
                alert.innerHTML = `
                    <i class="fas fa-check-circle me-2"></i>
                    <strong>Success!</strong> Your profile has been updated.
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;
                this.parentNode.insertBefore(alert, this.nextSibling);

                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
            }, 1500);
        });
    </script>
}