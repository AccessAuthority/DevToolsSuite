@{
    ViewData["Title"] = "Dashboard - DevTools Suite";
}

<div class="container-fluid py-4">
    <div class="row">
        <!-- Welcome Section -->
        <div class="col-12 mb-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h3 fw-bold mb-1">Welcome back, @User.Identity.Name! 👋</h1>
                    <p class="text-muted">Here's your developer tools dashboard</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-primary">
                        <i class="fas fa-plus me-2"></i>New Tool
                    </button>
                    <button class="btn btn-primary">
                        <i class="fas fa-rocket me-2"></i>Upgrade
                    </button>
                </div>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-muted mb-2">Tools Used Today</h6>
                            <h3 class="fw-bold text-primary" id="todayUsage">0</h3>
                        </div>
                        <div class="bg-primary bg-opacity-10 rounded p-3">
                            <i class="fas fa-tools fa-2x text-primary"></i>
                        </div>
                    </div>
                    <p class="text-muted small mb-0">
                        <span id="usageTrend" class="text-success">+0%</span> from yesterday
                    </p>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-muted mb-2">Saved Sessions</h6>
                            <h3 class="fw-bold text-success" id="savedCount">0</h3>
                        </div>
                        <div class="bg-success bg-opacity-10 rounded p-3">
                            <i class="fas fa-save fa-2x text-success"></i>
                        </div>
                    </div>
                    <p class="text-muted small mb-0">Your saved tool sessions</p>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-muted mb-2">Favorite Tools</h6>
                            <h3 class="fw-bold text-warning" id="favoritesCount">0</h3>
                        </div>
                        <div class="bg-warning bg-opacity-10 rounded p-3">
                            <i class="fas fa-star fa-2x text-warning"></i>
                        </div>
                    </div>
                    <p class="text-muted small mb-0">Your most used tools</p>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-muted mb-2">Productivity Score</h6>
                            <h3 class="fw-bold text-info" id="productivityScore">0</h3>
                        </div>
                        <div class="bg-info bg-opacity-10 rounded p-3">
                            <i class="fas fa-chart-line fa-2x text-info"></i>
                        </div>
                    </div>
                    <p class="text-muted small mb-0">Based on your tool usage</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Recent Activity -->
        <div class="col-lg-8 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="fw-bold mb-0">Recent Activity</h5>
                </div>
                <div class="card-body">
                    <div id="recentActivity">
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="text-muted mt-2">Loading your activity...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Tools -->
        <div class="col-lg-4 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="fw-bold mb-0">Quick Tools</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="/tools/json-formatter" class="btn btn-outline-primary text-start">
                            <i class="fas fa-brackets-curly me-2"></i>JSON Formatter
                        </a>
                        <a href="/tools/jwt-decoder" class="btn btn-outline-primary text-start">
                            <i class="fas fa-lock me-2"></i>JWT Decoder
                        </a>
                        <a href="/tools/base64-converter" class="btn btn-outline-primary text-start">
                            <i class="fas fa-code me-2"></i>Base64 Converter
                        </a>
                        <a href="/tools/regex-tester" class="btn btn-outline-primary text-start">
                            <i class="fas fa-asterisk me-2"></i>Regex Tester
                        </a>
                        <a href="/tools" class="btn btn-outline-secondary text-start mt-3">
                            <i class="fas fa-toolbox me-2"></i>View All Tools
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Saved Sessions -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0">Saved Tool Sessions</h5>
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                <i class="fas fa-filter me-2"></i>Filter
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#" data-filter="all">All Tools</a></li>
                                <li><a class="dropdown-item" href="#" data-filter="json-formatter">JSON Formatter</a></li>
                                <li><a class="dropdown-item" href="#" data-filter="jwt-decoder">JWT Decoder</a></li>
                                <li><a class="dropdown-item" href="#" data-filter="base64-converter">Base64 Converter</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div id="savedSessionsList">
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="text-muted mt-2">Loading your saved sessions...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            loadDashboardData();
            loadSavedSessions();
        });

        async function loadDashboardData() {
            try {
                // Simulate API calls
                setTimeout(() => {
                    document.getElementById('todayUsage').textContent = '12';
                    document.getElementById('usageTrend').textContent = '+20%';
                    document.getElementById('savedCount').textContent = '8';
                    document.getElementById('favoritesCount').textContent = '3';
                    document.getElementById('productivityScore').textContent = '85';

                    // Load recent activity
                    const activity = [
                        { tool: 'JSON Formatter', time: '2 minutes ago', action: 'Formatted API response' },
                        { tool: 'JWT Decoder', time: '1 hour ago', action: 'Decoded auth token' },
                        { tool: 'Base64 Converter', time: '3 hours ago', action: 'Encoded image data' },
                        { tool: 'Regex Tester', time: '5 hours ago', action: 'Tested email pattern' }
                    ];

                    const activityHtml = activity.map(item => `
                        <div class="border-bottom pb-3 mb-3">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h6 class="fw-bold mb-1">${item.tool}</h6>
                                    <p class="text-muted mb-0 small">${item.action}</p>
                                </div>
                                <span class="text-muted small">${item.time}</span>
                            </div>
                        </div>
                    `).join('');

                    document.getElementById('recentActivity').innerHTML = activityHtml;
                }, 1000);
            } catch (error) {
                console.error('Error loading dashboard data:', error);
            }
        }

        async function loadSavedSessions() {
            try {
                const response = await fetch('/api/tools/saved');
                if (response.ok) {
                    const sessions = await response.json();
                    displaySavedSessions(sessions);
                }
            } catch (error) {
                console.error('Error loading saved sessions:', error);
                document.getElementById('savedSessionsList').innerHTML = `
                    <div class="text-center py-4">
                        <i class="fas fa-exclamation-triangle fa-2x text-muted mb-3"></i>
                        <p class="text-muted">Unable to load saved sessions</p>
                    </div>
                `;
            }
        }

        function displaySavedSessions(sessions) {
            if (sessions.length === 0) {
                document.getElementById('savedSessionsList').innerHTML = `
                    <div class="text-center py-5">
                        <i class="fas fa-save fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">No saved sessions yet</h5>
                        <p class="text-muted">Your saved tool sessions will appear here</p>
                        <a href="/tools" class="btn btn-primary mt-2">
                            <i class="fas fa-toolbox me-2"></i>Explore Tools
                        </a>
                    </div>
                `;
                return;
            }

            const sessionsHtml = sessions.map(session => `
                <div class="card mb-3 session-card" data-tool="${session.toolName}">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center mb-2">
                                    <span class="badge bg-primary me-2">${session.toolName}</span>
                                    <small class="text-muted">${new Date(session.createdAt).toLocaleDateString()}</small>
                                </div>
                                <p class="mb-2 small text-truncate">${session.inputData}</p>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-outline-primary" onclick="loadSession(${session.id})">
                                        <i class="fas fa-play me-1"></i>Load
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteSession(${session.id})">
                                        <i class="fas fa-trash me-1"></i>Delete
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `).join('');

            document.getElementById('savedSessionsList').innerHTML = sessionsHtml;
            document.getElementById('savedCount').textContent = sessions.length;
        }

        async function loadSession(sessionId) {
            // Redirect to the appropriate tool with session data
            // This would typically load the session data into the tool
            alert('Loading session ' + sessionId);
        }

        async function deleteSession(sessionId) {
            if (confirm('Are you sure you want to delete this session?')) {
                try {
                    const response = await fetch(`/api/tools/saved/${sessionId}`, {
                        method: 'DELETE'
                    });

                    if (response.ok) {
                        loadSavedSessions(); // Reload the list
                    }
                } catch (error) {
                    console.error('Error deleting session:', error);
                    alert('Error deleting session');
                }
            }
        }

        // Filter functionality
        document.querySelectorAll('[data-filter]').forEach(item => {
            item.addEventListener('click', function(e) {
                e.preventDefault();
                const filter = this.getAttribute('data-filter');
                filterSessions(filter);
            });
        });

        function filterSessions(filter) {
            const sessions = document.querySelectorAll('.session-card');
            sessions.forEach(session => {
                if (filter === 'all' || session.getAttribute('data-tool') === filter) {
                    session.style.display = 'block';
                } else {
                    session.style.display = 'none';
                }
            });
        }
    </script>
}