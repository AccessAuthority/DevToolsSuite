@{
    ViewData["Title"] = "Page Not Found";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-5">
                    <div class="mb-4">
                        <i class="fas fa-map-signs fa-4x text-warning mb-3"></i>
                        <h1 class="display-4 fw-bold text-warning">404</h1>
                        <h2 class="h4 text-muted mb-4">Page Not Found</h2>
                    </div>

                    <div class="mb-4">
                        <p class="text-muted">
                            The page you're looking for doesn't exist or has been moved.
                        </p>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                        <a href="/" class="btn btn-primary btn-lg">
                            <i class="fas fa-home me-2"></i>Go Home
                        </a>
                        <a href="/tools" class="btn btn-outline-primary btn-lg">
                            <i class="fas fa-toolbox me-2"></i>Browse Tools
                        </a>
                    </div>

                    <div class="mt-4">
                        <p class="text-muted small">
                            If you believe this is an error, please <a href="/contact">contact our support team</a>.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>