@model DevToolsSuite.Models.ViewModels.DashboardStatsViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Admin Dashboard</h1>
            <p class="text-muted">Overview of your DevTools Suite platform</p>
        </div>
        <div class="dropdown">
            <button class="btn btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <i class="fas fa-cog me-2"></i>Admin Actions
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="/admin/users"><i class="fas fa-user-plus me-2"></i>Manage Users</a></li>
                <li><a class="dropdown-item" href="/admin/tool-usage"><i class="fas fa-chart-bar me-2"></i>View Usage Stats</a></li>
                <li><a class="dropdown-item" href="/admin/payments"><i class="fas fa-credit-card me-2"></i>Payment History</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="/admin/system-health"><i class="fas fa-cogs me-2"></i>System Health</a></li>
            </ul>
        </div>
    </div>

    <!-- Stats Overview -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title text-muted mb-2">Total Users</h6>
                            <h3 class="fw-bold text-primary">@Model.TotalUsers</h3>
                        </div>
                        <div class="bg-primary bg-opacity-10 rounded p-3">
                            <i class="fas fa-users fa-2x text-primary"></i>
                        </div>
                    </div>
                    <p class="text-muted small mb-0">
                        <span class="text-success">+@Model.NewUsersThisWeek this week</span>
                    </p>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title text-muted mb-2">Active Today</h6>
                            <h3 class="fw-bold text-success">@Model.ActiveToday</h3>
                        </div>
                        <div class="bg-success bg-opacity-10 rounded p-3">
                            <i class="fas fa-chart-line fa-2x text-success"></i>
                        </div>
                    </div>
                    <p class="text-muted small mb-0">Active users today</p>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title text-muted mb-2">Tool Uses</h6>
                            <h3 class="fw-bold text-warning">@Model.TotalToolUses</h3>
                        </div>
                        <div class="bg-warning bg-opacity-10 rounded p-3">
                            <i class="fas fa-tools fa-2x text-warning"></i>
                        </div>
                    </div>
                    <p class="text-muted small mb-0">
                        <span class="text-success">@Model.ToolUsesThisMonth this month</span>
                    </p>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title text-muted mb-2">Monthly Revenue</h6>
                            <h3 class="fw-bold text-info">₹@Model.MonthlyRevenue</h3>
                        </div>
                        <div class="bg-info bg-opacity-10 rounded p-3">
                            <i class="fas fa-rupee-sign fa-2x text-info"></i>
                        </div>
                    </div>
                    <p class="text-muted small mb-0">
                        <span class="text-success">@Model.ProUsers Pro + @Model.TeamUsers Team users</span>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Recent Activity -->
        <div class="col-lg-8 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0">Recent Activity</h5>
                        <a href="/admin/tool-usage" class="btn btn-sm btn-outline-primary">View All</a>
                    </div>
                </div>
                <div class="card-body">
                    <div id="recentActivity">
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="text-muted mt-2">Loading recent activity...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Stats -->
        <div class="col-lg-4 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="fw-bold mb-0">Quick Stats</h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item border-0 px-0 py-2 d-flex justify-content-between align-items-center">
                            <span>Pro Users</span>
                            <span class="badge bg-primary">@Model.ProUsers</span>
                        </div>
                        <div class="list-group-item border-0 px-0 py-2 d-flex justify-content-between align-items-center">
                            <span>Team Users</span>
                            <span class="badge bg-warning">@Model.TeamUsers</span>
                        </div>
                        <div class="list-group-item border-0 px-0 py-2 d-flex justify-content-between align-items-center">
                            <span>Pending Payments</span>
                            <span class="badge bg-secondary">@Model.PendingPayments</span>
                        </div>
                        <div class="list-group-item border-0 px-0 py-2 d-flex justify-content-between align-items-center">
                            <span>New Users (Week)</span>
                            <span class="badge bg-success">@Model.NewUsersThisWeek</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tool Usage Overview -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0">Tool Usage Overview</h5>
                        <div>
                            <button class="btn btn-sm btn-outline-primary" onclick="exportToolUsage()">
                                <i class="fas fa-download me-2"></i>Export
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div id="toolUsageChart">
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="text-muted mt-2">Loading tool usage data...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            loadRecentActivity();
            loadToolUsage();
        });

        async function loadRecentActivity() {
            try {
                // Simulate API call
                setTimeout(() => {
                    const activity = [
                        { user: 'john@example.com', action: 'Used JSON Formatter', time: '2 minutes ago' },
                        { user: 'sarah@example.com', action: 'Upgraded to Pro', time: '5 minutes ago' },
                        { user: 'mike@example.com', action: 'Used JWT Decoder', time: '10 minutes ago' },
                        { user: 'admin@devtoolssuite.com', action: 'Viewed reports', time: '15 minutes ago' },
                        { user: 'alex@example.com', action: 'Saved tool session', time: '20 minutes ago' }
                    ];

                    const html = activity.map(item => `
                        <div class="border-bottom pb-3 mb-3">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h6 class="fw-bold mb-1">${item.user}</h6>
                                    <p class="text-muted mb-0 small">${item.action}</p>
                                </div>
                                <span class="text-muted small">${item.time}</span>
                            </div>
                        </div>
                    `).join('');

                    document.getElementById('recentActivity').innerHTML = html;
                }, 1000);
            } catch (error) {
                console.error('Error loading recent activity:', error);
            }
        }

        async function loadToolUsage() {
            try {
                const response = await fetch('/api/admin/tool-usage');
                if (response.ok) {
                    const result = await response.json();
                    if (result.success) {
                        displayToolUsage(result.data);
                    }
                }
            } catch (error) {
                console.error('Error loading tool usage:', error);
            }
        }

        function displayToolUsage(data) {
            const html = data.stats.map(tool => `
                <div class="row align-items-center mb-3">
                    <div class="col-md-3">
                        <strong>${tool.toolName}</strong>
                    </div>
                    <div class="col-md-7">
                        <div class="progress" style="height: 10px;">
                            <div class="progress-bar" role="progressbar"
                                 style="width: ${(tool.usageCount / data.totalUsage) * 100}%; background: #ff0000;">
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2 text-end">
                        <span class="badge bg-primary">${tool.usageCount}</span>
                    </div>
                </div>
            `).join('');

            document.getElementById('toolUsageChart').innerHTML = html;
        }

        function exportToolUsage() {
            // Implement export functionality
            alert('Export functionality would be implemented here');
        }
    </script>
}