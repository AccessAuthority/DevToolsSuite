@{
    ViewData["Title"] = "DevTools Suite - All Developer Tools Unified";
}

<!-- Hero Section -->
<section class="hero-section bg-gradient text-white py-5" style="background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);">
    <div class="container py-5">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <div class="badge bg-primary bg-opacity-20 px-3 py-2 rounded-pill mb-3">
                    <i class="fas fa-rocket me-1"></i> MVP LAUNCHED
                </div>
                <h1 class="display-4 fw-bold mb-4">
                    All Your <span class="text-primary">Developer Tools</span> Unified & Secure.
                </h1>
                <p class="lead mb-4 text-light">
                    Streamline your workflow with our comprehensive suite of 10+ essential developer tools.
                    No more switching between tabs - everything you need in one lightning-fast platform.
                </p>
                <div class="d-flex flex-wrap gap-3 mb-4">
                    <a href="/tools" class="btn btn-primary btn-lg px-4 py-2">
                        <i class="fas fa-bolt me-2"></i>Try Tools Free
                    </a>
                    <a href="/pricing" class="btn btn-outline-light btn-lg px-4 py-2">
                        <i class="fas fa-crown me-2"></i>Go Pro
                    </a>
                </div>
                <div class="d-flex align-items-center text-muted">
                    <div class="d-flex me-4">
                        <i class="fas fa-star text-warning me-1"></i>
                        <i class="fas fa-star text-warning me-1"></i>
                        <i class="fas fa-star text-warning me-1"></i>
                        <i class="fas fa-star text-warning me-1"></i>
                        <i class="fas fa-star text-warning me-1"></i>
                    </div>
                    <span>Trusted by 10,000+ developers worldwide</span>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card border-0 shadow-lg">
                    <div class="card-body p-4">
                        <div class="d-flex gap-2 mb-3">
                            <div class="bg-danger rounded-circle" style="width: 12px; height: 12px;"></div>
                            <div class="bg-warning rounded-circle" style="width: 12px; height: 12px;"></div>
                            <div class="bg-success rounded-circle" style="width: 12px; height: 12px;"></div>
                        </div>
                        <div class="tool-preview">
                            <h6 class="text-muted mb-3">JSON Formatter Preview</h6>
                            <pre class="p-3 rounded bg-dark text-light"><code>{
  "name": "DevTools Suite",
  "tools": 10,
  "users": 10000,
  "features": [
    "JSON Formatter",
    "JWT Decoder", 
    "Base64 Converter",
    "Regex Tester"
  ]
}</code></pre>
                            <div class="d-flex gap-2 mt-3">
                                <button class="btn btn-sm btn-primary">
                                    <i class="fas fa-play me-1"></i>Format
                                </button>
                                <button class="btn btn-sm btn-outline-secondary">
                                    <i class="fas fa-copy me-1"></i>Copy
                                </button>
                                <button class="btn btn-sm btn-outline-secondary">
                                    <i class="fas fa-download me-1"></i>Download
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="py-5 bg-light">
    <div class="container py-5">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold mb-3">Why Choose DevTools Suite?</h2>
            <p class="lead text-muted">Built for developers, by developers</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                            <i class="fas fa-bolt fa-2x"></i>
                        </div>
                        <h5 class="fw-bold">Lightning Fast</h5>
                        <p class="text-muted">All tools process instantly in your browser. No delays, no waiting.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                            <i class="fas fa-shield-alt fa-2x"></i>
                        </div>
                        <h5 class="fw-bold">Privacy First</h5>
                        <p class="text-muted">Your data never leaves your browser. No tracking, no ads.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                            <i class="fas fa-infinity fa-2x"></i>
                        </div>
                        <h5 class="fw-bold">Unlimited Use</h5>
                        <p class="text-muted">Free tier includes all core tools. No limits, no hidden costs.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Tools Preview Section -->
<section class="py-5">
    <div class="container py-5">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold mb-3">Popular Developer Tools</h2>
            <p class="lead text-muted">10+ essential tools at your fingertips</p>
        </div>
        <div class="row g-4">
            <!-- Tool 1 -->
            <div class="col-md-6 col-lg-4">
                <div class="card tool-card h-100 border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-primary bg-opacity-10 rounded p-2 me-3">
                                <i class="fas fa-brackets-curly fa-lg"></i>
                            </div>
                            <h5 class="fw-bold mb-0">JSON Formatter</h5>
                        </div>
                        <p class="text-muted mb-3">Format and validate JSON data with syntax highlighting and error detection.</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge bg-primary">Most Popular</span>
                            <a href="/tools/json-formatter" class="btn btn-sm btn-outline-primary">Try Now</a>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Tool 2 -->
            <div class="col-md-6 col-lg-4">
                <div class="card tool-card h-100 border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-primary bg-opacity-10 rounded p-2 me-3">
                                <i class="fas fa-lock fa-lg"></i>
                            </div>
                            <h5 class="fw-bold mb-0">JWT Decoder</h5>
                        </div>
                        <p class="text-muted mb-3">Decode and inspect JWT tokens with header and payload visualization.</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge bg-success">Security</span>
                            <a href="/tools/jwt-decoder" class="btn btn-sm btn-outline-primary">Try Now</a>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Tool 3 -->
            <div class="col-md-6 col-lg-4">
                <div class="card tool-card h-100 border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-primary bg-opacity-10 rounded p-2 me-3">
                                <i class="fas fa-code fa-lg"></i>
                            </div>
                            <h5 class="fw-bold mb-0">Base64 Converter</h5>
                        </div>
                        <p class="text-muted mb-3">Encode and decode Base64 strings with support for files and images.</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge bg-info">Encoding</span>
                            <a href="/tools/base64-converter" class="btn btn-sm btn-outline-primary">Try Now</a>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Tool 4 -->
            <div class="col-md-6 col-lg-4">
                <div class="card tool-card h-100 border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-primary bg-opacity-10 rounded p-2 me-3">
                                <i class="fas fa-asterisk fa-lg"></i>
                            </div>
                            <h5 class="fw-bold mb-0">Regex Tester</h5>
                        </div>
                        <p class="text-muted mb-3">Test and debug regular expressions with real-time matching and groups.</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge bg-warning">Advanced</span>
                            <a href="/tools/regex-tester" class="btn btn-sm btn-outline-primary">Try Now</a>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Tool 5 -->
            <div class="col-md-6 col-lg-4">
                <div class="card tool-card h-100 border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-primary bg-opacity-10 rounded p-2 me-3">
                                <i class="fas fa-exchange-alt fa-lg"></i>
                            </div>
                            <h5 class="fw-bold mb-0">YAML/JSON Converter</h5>
                        </div>
                        <p class="text-muted mb-3">Convert between YAML and JSON formats seamlessly with validation.</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge bg-secondary">Converter</span>
                            <a href="/tools/yaml-json-converter" class="btn btn-sm btn-outline-primary">Try Now</a>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Tool 6 -->
            <div class="col-md-6 col-lg-4">
                <div class="card tool-card h-100 border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-primary bg-opacity-10 rounded p-2 me-3">
                                <i class="fas fa-link fa-lg"></i>
                            </div>
                            <h5 class="fw-bold mb-0">URL Encoder</h5>
                        </div>
                        <p class="text-muted mb-3">Encode and decode URL components with full URI support.</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge bg-info">Web</span>
                            <a href="/tools/url-encoder" class="btn btn-sm btn-outline-primary">Try Now</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="text-center mt-5">
            <a href="/tools" class="btn btn-primary btn-lg px-5">
                <i class="fas fa-toolbox me-2"></i>View All Tools
            </a>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="py-5 bg-primary text-white">
    <div class="container py-5 text-center">
        <h2 class="display-5 fw-bold mb-3">Ready to Boost Your Productivity?</h2>
        <p class="lead mb-4">Join thousands of developers who save hours every week with DevTools Suite</p>
        <div class="d-flex flex-wrap justify-content-center gap-3">
            <a href="/register" class="btn btn-light btn-lg px-5 py-2 fw-bold">
                <i class="fas fa-rocket me-2"></i>Get Started Free
            </a>
            <a href="/pricing" class="btn btn-outline-light btn-lg px-5 py-2">
                <i class="fas fa-crown me-2"></i>See Pro Features
            </a>
        </div>
    </div>
</section>

