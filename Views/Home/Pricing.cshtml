                        <div class="col-md-6">
                            <ul class="list-unstyled">
                                <li class="mb-2">
                                    <i class="fas fa-check text-primary me-2"></i>
                                    Unlimited team members
                                </li>
                                <li class="mb-2">
                                    <i class="fas fa-check text-primary me-2"></i>
                                    Custom tool development
                                </li>
                                <li class="mb-2">
                                    <i class="fas fa-check text-primary me-2"></i>
