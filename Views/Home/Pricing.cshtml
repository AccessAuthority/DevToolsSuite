                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Team workspaces
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Admin dashboard
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Usage analytics
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
