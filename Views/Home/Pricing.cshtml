                </div>
            </div>
        </div>

        <!-- Pro Plan -->
        <div class="col-lg-4">
            <div class="card h-100 border-0 shadow-lg position-relative" style="border: 2px solid #ff0000 !important;">
                <div class="position-absolute top-0 start-50 translate-middle">
                    <span class="badge bg-primary px-3 py-2">MOST POPULAR</span>
                </div>
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <h5 class="fw-bold">Pro</h5>
                        <div class="price-display">
                            <span class="h1 fw-bold">₹299</span>
                            <span class="text-muted">/month</span>
                        </div>
                        <div class="yearly-price d-none">
                            <span class="h1 fw-bold">₹249</span>
                            <span class="text-muted">/month</span>
                            <div class="text-success small">Billed annually (₹2,988)</div>
                        </div>
                        <p class="text-muted">For professional developers and power users</p>
                    </div>

                    <ul class="list-unstyled mb-4">
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
