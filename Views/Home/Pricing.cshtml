                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Light/Dark theme
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            Copy to clipboard
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-times text-muted me-2"></i>
                            <span class="text-muted">Save tool sessions</span>
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-times text-muted me-2"></i>
