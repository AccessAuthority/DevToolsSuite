@{
    ViewData["Title"] = ViewData["ToolName"] + " - DevTools Suite";
    var toolSlug = ViewData["ToolSlug"] as string;
    var toolName = ViewData["ToolName"] as string;
}

<div class="container-fluid py-4">
    <div class="row">
        <!-- Main Tool Area -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0 py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="fw-bold mb-0">@toolName</h4>
                            <p class="text-muted mb-0" id="toolDescription">Loading tool description...</p>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-secondary btn-sm" id="saveTool" data-bs-toggle="tooltip" title="Save session" disabled>
                                <i class="fas fa-save"></i>
                            </button>
                            <button class="btn btn-outline-secondary btn-sm" id="resetTool" data-bs-toggle="tooltip" title="Reset">
                                <i class="fas fa-redo"></i>
                            </button>
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-cog"></i>
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#" id="copyOutputMenu"><i class="fas fa-copy me-2"></i>Copy Output</a></li>
                                    <li><a class="dropdown-item" href="#" id="downloadOutputMenu"><i class="fas fa-download me-2"></i>Download</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="#" id="shareTool"><i class="fas fa-share me-2"></i>Share</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Dynamic Tool Content -->
                    <div id="toolInterface">
                        <!-- This will be populated by JavaScript based on the tool -->
                    </div>
                </div>
            </div>

            <!-- Output Section -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="fw-bold mb-0">Output</h5>
                </div>
                <div class="card-body">
                    <div class="output-container">
                        <pre id="output" class="p-3 bg-light rounded border" style="min-height: 200px; max-height: 400px; overflow: auto;">Run the tool to see output...</pre>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <div>
                            <span id="processingTime" class="text-muted small"></span>
                            <span id="additionalInfo" class="text-muted small ms-2"></span>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-primary btn-sm" id="copyOutputBtn" disabled>
                                <i class="fas fa-copy me-1"></i>Copy
                            </button>
                            <button class="btn btn-outline-primary btn-sm" id="downloadOutputBtn" disabled>
                                <i class="fas fa-download me-1"></i>Download
                            </button>
                            <button class="btn btn-outline-primary btn-sm" id="clearOutputBtn">
                                <i class="fas fa-trash me-1"></i>Clear
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Tool Info -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0 py-3">
                    <h6 class="fw-bold mb-0">About This Tool</h6>
                </div>
                <div class="card-body">
                    <div id="toolInfoContent">
                        <p class="text-muted small">Loading tool information...</p>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h6 class="fw-bold mb-0">Quick Actions</h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <button class="btn btn-outline-primary btn-sm" id="loadSampleDataBtn">
                            <i class="fas fa-file-alt me-2"></i>Load Sample Data
                        </button>
                        <button class="btn btn-outline-primary btn-sm" id="clearAllBtn">
                            <i class="fas fa-broom me-2"></i>Clear All
                        </button>
                        <a href="/tools" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-toolbox me-2"></i>Browse All Tools
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tool-specific templates -->
<script id="jsonFormatterTemplate" type="text/template">
    <div class="tool-interface">
        <div class="mb-3">
            <label class="form-label fw-bold">JSON Input</label>
            <textarea class="form-control font-monospace" id="jsonInput" rows="12" placeholder='Paste your JSON here...&#10;Example: {"name": "John", "age": 30, "city": "New York"}'></textarea>
            <div class="form-text">Maximum 50,000 characters</div>
        </div>
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="formatJson" checked>
                    <label class="form-check-label" for="formatJson">Format/Beautify</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="validateJson" checked>
                    <label class="form-check-label" for="validateJson">Validate</label>
                </div>
            </div>
        </div>
        <div class="d-grid">
            <button class="btn btn-primary btn-lg" id="processJsonBtn">
                <i class="fas fa-play me-2"></i>Format JSON
            </button>
        </div>
    </div>
</script>

<script id="jwtDecoderTemplate" type="text/template">
    <div class="tool-interface">
        <div class="mb-3">
            <label class="form-label fw-bold">JWT Token</label>
            <textarea class="form-control font-monospace" id="jwtInput" rows="6" placeholder="Paste your JWT token here..."></textarea>
            <div class="form-text">Maximum 50,000 characters</div>
        </div>
        <div class="alert alert-info">
            <small><i class="fas fa-info-circle me-2"></i>JWT tokens have three parts: header, payload, and signature, separated by dots.</small>
        </div>
        <div class="d-grid">
            <button class="btn btn-primary btn-lg" id="processJwtBtn">
                <i class="fas fa-play me-2"></i>Decode JWT
            </button>
        </div>
    </div>
</script>

<script id="base64ConverterTemplate" type="text/template">
    <div class="tool-interface">
        <div class="mb-3">
            <label class="form-label fw-bold">Input Text</label>
            <textarea class="form-control font-monospace" id="base64Input" rows="8" placeholder="Enter text to encode or base64 to decode..."></textarea>
            <div class="form-text">Maximum 50,000 characters</div>
        </div>
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="base64Action" id="encodeBase64" value="encode" checked>
                    <label class="form-check-label" for="encodeBase64">Encode to Base64</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="base64Action" id="decodeBase64" value="decode">
                    <label class="form-check-label" for="decodeBase64">Decode from Base64</label>
                </div>
            </div>
        </div>
        <div class="d-grid">
            <button class="btn btn-primary btn-lg" id="processBase64Btn">
                <i class="fas fa-play me-2"></i>Process
            </button>
        </div>
    </div>
</script>

<!-- Regex Tester Template -->
<script id="regexTesterTemplate" type="text/template">
    <div class="tool-interface">
        <div class="mb-3">
            <label class="form-label fw-bold">Test Text</label>
            <textarea class="form-control font-monospace" id="regexInput" rows="6" placeholder="Enter text to test against the regex pattern..."></textarea>
            <div class="form-text">Maximum 50,000 characters</div>
        </div>
        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label fw-bold">Regex Pattern</label>
                <input type="text" class="form-control font-monospace" id="regexPattern" placeholder="Enter regex pattern (e.g., \b\w+\b)">
                <div class="form-text">Maximum 1,000 characters</div>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Flags</label>
                <input type="text" class="form-control font-monospace" id="regexFlags" placeholder="g, i, m, s (e.g., gi)">
                <div class="form-text">g=global, i=ignore case, m=multiline, s=singleline</div>
            </div>
        </div>
        <div class="d-grid">
            <button class="btn btn-primary btn-lg" id="processRegexBtn">
                <i class="fas fa-play me-2"></i>Test Regex
            </button>
        </div>
    </div>
</script>

<!-- YAML/JSON Converter Template -->
