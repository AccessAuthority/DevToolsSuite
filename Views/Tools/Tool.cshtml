            <div class="col-md-6">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="yamlJsonAction" id="toJson" value="to-json" checked>
                    <label class="form-check-label" for="toJson">YAML to JSON</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="yamlJsonAction" id="toYaml" value="to-yaml">
                    <label class="form-check-label" for="toYaml">JSON to YAML</label>
                </div>
            </div>
        </div>
        <div class="d-grid">
            <button class="btn btn-primary btn-lg" id="processYamlJsonBtn">
                <i class="fas fa-play me-2"></i>Convert
            </button>
        </div>
    </div>
</script>

<!-- URL Encoder Template -->
