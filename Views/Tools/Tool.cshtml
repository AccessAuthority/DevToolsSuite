        };

        // ... [Keep EventManager and initialization code the same] ...
        // Event management
        const EventManager = {
            addEventListeners() {
                this.removeEventListeners();

                // Tool-specific buttons
                const toolButtons = {
                    'processJsonBtn': ToolProcessors.processJsonFormatter,
                    'processJwtBtn': ToolProcessors.processJwtDecoder,
                    'processBase64Btn': ToolProcessors.processBase64Converter,
                    'processRegexBtn': ToolProcessors.processRegexTester,
                    'processYamlJsonBtn': ToolProcessors.processYamlJsonConverter,
                    'processUrlBtn': ToolProcessors.processUrlEncoder,
                    'processTimestampBtn': ToolProcessors.processTimestampConverter,
                    'processTextDiffBtn': ToolProcessors.processTextDiff,
                    'processMarkdownBtn': ToolProcessors.processMarkdownPreview,
                    'processUuidBtn': ToolProcessors.processUuidGenerator
                };

                Object.entries(toolButtons).forEach(([id, handler]) => {
                    const element = document.getElementById(id);
                    if (element) {
                        const eventHandler = () => handler();
                        element.addEventListener('click', eventHandler);
                        AppState.eventListeners.push({ element, eventHandler });
                    }
                });

                // Global buttons
                const globalHandlers = {
                    'resetTool': this.clearAll,
                    'saveTool': this.saveSession,
                    'clearOutputBtn': this.clearOutput,
                    'copyOutputBtn': this.copyOutput,
                    'downloadOutputBtn': this.downloadOutput,
                    'loadSampleDataBtn': this.loadSampleData,
                    'clearAllBtn': this.clearAll
                };

                Object.entries(globalHandlers).forEach(([id, handler]) => {
                    const element = document.getElementById(id);
                    if (element) {
                        const eventHandler = () => handler();
                        element.addEventListener('click', eventHandler);
                        AppState.eventListeners.push({ element, eventHandler });
                    }
                });

                // Menu items
                const copyMenu = document.getElementById('copyOutputMenu');
                if (copyMenu) {
                    const eventHandler = (e) => {
                        e.preventDefault();
                        this.copyOutput();
                    };
                    copyMenu.addEventListener('click', eventHandler);
                    AppState.eventListeners.push({ element: copyMenu, eventHandler });
                }

                const downloadMenu = document.getElementById('downloadOutputMenu');
                if (downloadMenu) {
                    const eventHandler = (e) => {
                        e.preventDefault();
                        this.downloadOutput();
                    };
                    downloadMenu.addEventListener('click', eventHandler);
                    AppState.eventListeners.push({ element: downloadMenu, eventHandler });
                }
            },

            removeEventListeners() {
                AppState.eventListeners.forEach(({ element, eventHandler }) => {
                    element.removeEventListener('click', eventHandler);
                });
                AppState.eventListeners = [];
            },

            clearAll() {
                // Clear all inputs
                document.querySelectorAll('textarea').forEach(ta => ta.value = '');
                document.querySelectorAll('input[type="text"]').forEach(input => input.value = '');
                document.querySelectorAll('input[type="number"]').forEach(input => input.value = input.defaultValue || '');

                // Reset checkboxes and radios to defaults
                document.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = true);
                document.querySelectorAll('input[type="radio"]').forEach((radio, index) => {
                    if (index === 0) radio.checked = true;
                });

                // Clear output
                this.clearOutput();
                Utils.showNotification('All inputs cleared', 'info');
            },

            clearOutput() {
                document.getElementById('output').textContent = 'Run the tool to see output...';
                document.getElementById('output').className = 'p-3 bg-light rounded border';
                document.getElementById('processingTime').textContent = '';
                document.getElementById('additionalInfo').textContent = '';

                // Disable output buttons
                document.getElementById('copyOutputBtn').disabled = true;
                document.getElementById('downloadOutputBtn').disabled = true;
                document.getElementById('saveTool').disabled = true;
            },

            async copyOutput() {
                const output = document.getElementById('output').textContent;
                try {
                    await navigator.clipboard.writeText(output);
                    const button = document.getElementById('copyOutputBtn');
                    const originalText = button.innerHTML;
                    button.innerHTML = '<i class="fas fa-check me-1"></i>Copied!';
                    setTimeout(() => {
                        button.innerHTML = originalText;
                    }, 2000);
                    Utils.showNotification('Output copied to clipboard', 'success');
                } catch (err) {
                    Utils.showNotification('Failed to copy output', 'error');
                }
            },

            downloadOutput() {
                const output = document.getElementById('output').textContent;
                const blob = new Blob([output], { type: 'text/plain' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `devtools-${AppState.currentTool}-output.txt`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
                Utils.showNotification('Output downloaded', 'success');
            },

            loadSampleData() {
                const toolSlug = AppState.currentTool;
                if (!toolSlug) return;

                const samples = {
                    'json-formatter': '{"name": "DevTools Suite", "tools": 10, "users": 10000, "features": ["JSON Formatter", "JWT Decoder", "Base64 Converter"]}',
                    'jwt-decoder': 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c',
                    'base64-converter': 'Hello, DevTools Suite! This is sample text for encoding.',
                    'regex-tester': 'The quick brown fox jumps over the lazy dog.',
                    'yaml-json-converter': 'name: John Doe\nage: 30\ncity: New York\nhobbies:\n  - reading\n  - hiking\n  - coding',
                    'url-encoder': 'Hello World & Welcome!',
                    'timestamp-converter': '1640995200',
                    'text-diff': 'The quick brown fox\njumps over the lazy dog.',
                    'markdown-preview': '# Hello World\n\nThis is **bold** and this is *italic*.\n\n- List item 1\n- List item 2\n- List item 3',
                    'uuid-generator': '5'
                };

                switch (toolSlug) {
                    case 'text-diff':
                        document.getElementById('diffLeft').value = samples[toolSlug];
                        document.getElementById('diffRight').value = 'The quick brown fox\njumps over the lazy cat.';
                        break;
                    case 'regex-tester':
                        document.getElementById('regexInput').value = samples[toolSlug];
                        document.getElementById('regexPattern').value = '\\b\\w{4}\\b';
                        document.getElementById('regexFlags').value = 'g';
                        break;
                    case 'uuid-generator':
                        document.getElementById('uuidCount').value = samples[toolSlug];
                        break;
                    default:
                        const inputElement = document.querySelector('textarea, input[type="text"]');
                        if (inputElement && samples[toolSlug]) {
                            inputElement.value = samples[toolSlug];
                        }
                        break;
                }

                Utils.showNotification('Sample data loaded', 'info');
            },

            async saveSession() {
                if (!AppState.lastOutput) {
                    Utils.showNotification('No output to save', 'warning');
                    return;
                }
                Utils.showNotification('Session saving feature coming soon!', 'info');
            }
        };

        // Initialize tool
        function initializeTool() {
            const toolSlug = '@toolSlug';
            const config = toolConfig[toolSlug];

            if (config) {
                AppState.currentTool = toolSlug;

                // Load tool interface
                const template = document.getElementById(config.template);
                if (template) {
                    document.getElementById('toolInterface').innerHTML = template.innerHTML;
                } else {
                    document.getElementById('toolInterface').innerHTML = '<div class="alert alert-danger">Tool template not found</div>';
                    return;
                }

                // Update descriptions
                document.getElementById('toolDescription').textContent = config.description;
                document.getElementById('toolInfoContent').innerHTML = `<p class="text-muted small">${Utils.escapeHtml(config.info)}</p>`;

                // Initialize event listeners
                EventManager.addEventListeners();

                // Initialize tooltips
                const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                const tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                    return new bootstrap.Tooltip(tooltipTriggerEl);
                });

                console.log('✅ Tool initialized:', toolSlug);
            } else {
                document.getElementById('toolInterface').innerHTML = '<div class="alert alert-danger">Tool configuration not found</div>';
            }
        }

        // Make functions available globally
        window.ToolProcessors = ToolProcessors;
        window.EventManager = EventManager;

        // Initialize when DOM is loaded
        document.addEventListener('DOMContentLoaded', function() {
            initializeTool();
        });

        // Cleanup on page unload
        window.addEventListener('beforeunload', function() {
            EventManager.removeEventListeners();
        });

        console.log('✅ DevTools Suite JavaScript loaded successfully!');
    </script>
}