            <div class="form-text">Maximum 50,000 characters</div>
        </div>
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="urlAction" id="encodeUrl" value="encode" checked>
                    <label class="form-check-label" for="encodeUrl">Encode URL</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="urlAction" id="decodeUrl" value="decode">
                    <label class="form-check-label" for="decodeUrl">Decode URL</label>
                </div>
            </div>
        </div>
        <div class="d-grid">
            <button class="btn btn-primary btn-lg" id="processUrlBtn">
                <i class="fas fa-play me-2"></i>Process
