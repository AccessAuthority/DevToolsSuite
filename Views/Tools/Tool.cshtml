                const action = document.querySelector('input[name="urlAction"]:checked').value;
                const encode = action === 'encode';
                const button = document.getElementById('processUrlBtn');

                const config = toolConfig['url-encoder'];
                const error = Utils.validateInput(input, config.maxInputLength, config.requiresInput);
                if (error) {
                    Utils.showNotification(error, 'error');
                    return;
                }

                Utils.setLoading(button, true);
                await ApiService.processTool('url-encoder', {
                    input: input,
                    encode: encode
