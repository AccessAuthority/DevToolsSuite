<!-- Timestamp Converter Template -->
<script id="timestampConverterTemplate" type="text/template">
    <div class="tool-interface">
        <div class="mb-3">
            <label class="form-label fw-bold">Timestamp or Date</label>
            <input type="text" class="form-control font-monospace" id="timestampInput" placeholder="Enter timestamp (seconds/ms) or date string (leave empty for current time)">
            <div class="form-text">Supports Unix seconds, milliseconds, or date strings</div>
        </div>
        <div class="alert alert-info">
            <small><i class="fas fa-info-circle me-2"></i>Supports Unix timestamps (seconds/milliseconds) and various date formats. Leave empty to show current time.</small>
        </div>
        <div class="d-grid">
            <button class="btn btn-primary btn-lg" id="processTimestampBtn">
                <i class="fas fa-play me-2"></i>Convert
            </button>
        </div>
    </div>
</script>

<!-- Text Diff Template -->
