                Utils.setLoading(button, true);
                await ApiService.processTool('text-diff', {
                    input: left,
                    input2: right
                });
                Utils.setLoading(button, false);
            },

            async processMarkdownPreview() {
                const input = document.getElementById('markdownInput').value;
                const button = document.getElementById('processMarkdownBtn');

                const config = toolConfig['markdown-preview'];
                const error = Utils.validateInput(input, config.maxInputLength, config.requiresInput);
                if (error) {
                    Utils.showNotification(error, 'error');
                    return;
                }

                Utils.setLoading(button, true);
                await ApiService.processTool('markdown-preview', { input: input });
                Utils.setLoading(button, false);
            },

            async processUuidGenerator() {
                const count = parseInt(document.getElementById('uuidCount').value) || 1;
                const button = document.getElementById('processUuidBtn');

                if (count < 1 || count > 100) {
                    Utils.showNotification('Count must be between 1 and 100', 'error');
                    return;
                }

                Utils.setLoading(button, true);
                // FIXED: UUID generator now uses the correct parameter structure
                await ApiService.processTool('uuid-generator', {
                    input: '', // Required field but empty for UUID generator
                    count: count
                });
                Utils.setLoading(button, false);
