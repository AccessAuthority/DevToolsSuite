@section Scripts {
    <script>
        // Enhanced tool configuration with validation
        const toolConfig = {
            'json-formatter': {
                template: 'jsonFormatterTemplate',
                description: 'Format and validate JSON data with syntax highlighting',
                info: 'This tool helps you format, validate, and beautify JSON data. It provides syntax highlighting and error detection to ensure your JSON is properly structured.',
                maxInputLength: 50000,
                requiresInput: true
            },
            'jwt-decoder': {
                template: 'jwtDecoderTemplate',
                description: 'Decode and inspect JWT tokens',
                info: 'Decode JSON Web Tokens (JWT) to inspect their header and payload contents. This is useful for debugging authentication tokens and understanding their structure.',
                maxInputLength: 50000,
                requiresInput: true
            },
            'base64-converter': {
                template: 'base64ConverterTemplate',
                description: 'Encode and decode Base64 strings',
                info: 'Convert text to Base64 encoding and decode Base64 back to text. Useful for data encoding in URLs, APIs, and various web applications.',
                maxInputLength: 50000,
                requiresInput: true
            },
            'regex-tester': {
                template: 'regexTesterTemplate',
                description: 'Test regular expressions with live matching',
                info: 'Test and debug regular expressions with real-time matching. See matches, groups, and positions with detailed output.',
                maxInputLength: 50000,
                maxPatternLength: 1000,
                requiresInput: false
            },
            'yaml-json-converter': {
                template: 'yamlJsonConverterTemplate',
                description: 'Convert between YAML and JSON formats',
                info: 'Easily convert between YAML and JSON formats. Perfect for configuration files, API development, and data transformation.',
                maxInputLength: 50000,
                requiresInput: true
            },
            'url-encoder': {
                template: 'urlEncoderTemplate',
                description: 'Encode and decode URL components',
                info: 'URL encode and decode strings to ensure proper formatting for web addresses and API parameters.',
                maxInputLength: 50000,
                requiresInput: true
            },
            'timestamp-converter': {
                template: 'timestampConverterTemplate',
                description: 'Convert between timestamps and human-readable dates',
                info: 'Convert Unix timestamps to readable dates and vice versa. Supports seconds, milliseconds, and various date formats.',
                maxInputLength: 100,
                requiresInput: false
            },
            'text-diff': {
                template: 'textDiffTemplate',
                description: 'Compare text and find differences',
                info: 'Compare two text inputs and highlight differences between them. Useful for code reviews, document comparison, and change tracking.',
                maxInputLength: 50000,
                requiresInput: false
            },
            'markdown-preview': {
                template: 'markdownPreviewTemplate',
                description: 'Preview Markdown in real-time',
                info: 'Write Markdown and see the rendered HTML output in real-time. Perfect for documentation and content creation.',
                maxInputLength: 50000,
                requiresInput: true
            },
            'uuid-generator': {
                template: 'uuidGeneratorTemplate',
                description: 'Generate UUIDs/GUIDs',
                info: 'Generate random UUIDs (Universally Unique Identifiers) for use in databases, APIs, and distributed systems.',
                maxInputLength: 0,
                requiresInput: false
            }
        };

        // Application state
        const AppState = {
            currentTool: null,
            isProcessing: false,
            lastOutput: '',
            eventListeners: []
        };

        // Utility functions
        const Utils = {
            escapeHtml(unsafe) {
                if (!unsafe) return '';
                return unsafe
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            },

            showNotification(message, type = 'info') {
                // Remove existing notifications
                const existingAlert = document.querySelector('.alert-dismissible');
                if (existingAlert) {
                    existingAlert.remove();
                }

                const alertClass = {
                    'success': 'alert-success',
                    'error': 'alert-danger',
                    'warning': 'alert-warning',
                    'info': 'alert-info'
                }[type] || 'alert-info';

                const alertHtml = `
                    <div class="alert ${alertClass} alert-dismissible fade show" role="alert">
                        ${this.escapeHtml(message)}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                `;

                const container = document.querySelector('.container-fluid');
                container.insertAdjacentHTML('afterbegin', alertHtml);
            },

            setLoading(button, loading) {
                if (!button) return;

                if (loading) {
                    button.disabled = true;
                    const originalText = button.innerHTML;
                    button.setAttribute('data-original-text', originalText);
                    button.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Processing...';
                } else {
                    button.disabled = false;
                    const originalText = button.getAttribute('data-original-text');
                    if (originalText) {
                        button.innerHTML = originalText;
                    }
                }
            },

            validateInput(input, maxLength = 50000, required = true) {
                if (required && (!input || !input.trim())) {
                    return 'Input cannot be empty';
                }
                if (maxLength > 0 && input.length > maxLength) {
                    return `Input too long. Maximum ${maxLength} characters allowed.`;
                }
                return null;
            }
        };

        // API service - COMPLETELY FIXED
        const ApiService = {
            async processTool(toolSlug, data) {
                const startTime = Date.now();
                const outputElement = document.getElementById('output');
                const processingTimeElement = document.getElementById('processingTime');

                try {
                    AppState.isProcessing = true;
                    outputElement.textContent = 'Processing...';
                    outputElement.className = 'p-3 bg-warning bg-opacity-25 rounded border';
                    processingTimeElement.textContent = '';
                    document.getElementById('additionalInfo').textContent = '';

                    // FIXED: Use the new API controller structure
                    const requestData = {
                        Input: data.input || '',
                        Options: {},
                        SaveResult: data.saveResult || false
                    };

                    // Add options based on tool type
                    if (data.encode !== undefined) requestData.Options.encode = data.encode;
                    if (data.format !== undefined) requestData.Options.format = data.format;
                    if (data.validate !== undefined) requestData.Options.validate = data.validate;
                    if (data.toJson !== undefined) requestData.Options.toJson = data.toJson;
                    if (data.count !== undefined) requestData.Options.count = data.count;
                    if (data.pattern !== undefined) requestData.Options.pattern = data.pattern;
                    if (data.flags !== undefined) requestData.Options.flags = data.flags;
                    if (data.input2 !== undefined) requestData.Options.input2 = data.input2;

                    console.log('🔍 Sending request:', { toolSlug, requestData });

                    const response = await fetch(`/api/tools/${toolSlug}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify(requestData)
                    });

                    const responseText = await response.text();
                    let result;

                    try {
                        result = JSON.parse(responseText);
                    } catch (parseError) {
                        console.error('Failed to parse response:', responseText);
                        throw new Error(`Invalid JSON response: ${responseText.substring(0, 100)}`);
                    }

                    const processingTime = Date.now() - startTime;

                    console.log('🔍 Received response:', result);

                    if (!response.ok) {
                        const errorDetails = result.error || result.message || `HTTP ${response.status}`;
                        throw new Error(errorDetails);
                    }

                    // Handle the new API response structure
                    if (result.success) {
                        const output = result.data?.output || result.output || 'Success';
                        const additionalData = result.data?.additionalData || result.additionalData;

                        AppState.lastOutput = output;

                        // Handle HTML output for markdown preview
                        if (toolSlug === 'markdown-preview') {
                            outputElement.innerHTML = output;
                        } else {
                            outputElement.textContent = output;
                        }

                        outputElement.className = 'p-3 bg-success bg-opacity-10 rounded border';
                        processingTimeElement.textContent = `Processed in ${processingTime}ms`;

                        if (additionalData) {
                            document.getElementById('additionalInfo').textContent = additionalData;
                        }

                        // Enable output buttons
                        document.getElementById('copyOutputBtn').disabled = false;
                        document.getElementById('downloadOutputBtn').disabled = false;
                        document.getElementById('saveTool').disabled = false;

                        Utils.showNotification('Tool processed successfully', 'success');
                    } else {
                        const error = result.error || result.message || 'Unknown error occurred';
                        outputElement.textContent = `Error: ${error}`;
                        outputElement.className = 'p-3 bg-danger bg-opacity-10 rounded border';
                        processingTimeElement.textContent = '';
                        Utils.showNotification(error, 'error');
                    }
                } catch (error) {
                    console.error('💥 Process tool error:', error);
                    outputElement.textContent = `Error: ${error.message}`;
                    outputElement.className = 'p-3 bg-danger bg-opacity-10 rounded border';
                    processingTimeElement.textContent = '';
                    document.getElementById('additionalInfo').textContent = '';
                    Utils.showNotification(error.message, 'error');
                } finally {
                    AppState.isProcessing = false;
                }
            }
        };

        // Tool processing functions - COMPLETELY FIXED
        const ToolProcessors = {
            async processJsonFormatter() {
                const input = document.getElementById('jsonInput').value;
                const format = document.getElementById('formatJson').checked;
                const validate = document.getElementById('validateJson').checked;
                const button = document.getElementById('processJsonBtn');

                const config = toolConfig['json-formatter'];
                const error = Utils.validateInput(input, config.maxInputLength, config.requiresInput);
                if (error) {
                    Utils.showNotification(error, 'error');
                    return;
                }

                Utils.setLoading(button, true);
                await ApiService.processTool('json-formatter', {
                    input: input,
                    format: format,
                    validate: validate
                });
                Utils.setLoading(button, false);
            },

            async processJwtDecoder() {
                const input = document.getElementById('jwtInput').value;
                const button = document.getElementById('processJwtBtn');

                const config = toolConfig['jwt-decoder'];
                const error = Utils.validateInput(input, config.maxInputLength, config.requiresInput);
                if (error) {
                    Utils.showNotification(error, 'error');
                    return;
                }

                Utils.setLoading(button, true);
                await ApiService.processTool('jwt-decoder', { input: input });
                Utils.setLoading(button, false);
            },

            async processBase64Converter() {
                const input = document.getElementById('base64Input').value;
                const action = document.querySelector('input[name="base64Action"]:checked').value;
                const encode = action === 'encode';
                const button = document.getElementById('processBase64Btn');

                const config = toolConfig['base64-converter'];
                const error = Utils.validateInput(input, config.maxInputLength, config.requiresInput);
                if (error) {
                    Utils.showNotification(error, 'error');
                    return;
                }

                Utils.setLoading(button, true);
                await ApiService.processTool('base64-converter', {
                    input: input,
                    encode: encode
                });
                Utils.setLoading(button, false);
            },

            async processRegexTester() {
                const input = document.getElementById('regexInput').value;
                const pattern = document.getElementById('regexPattern').value;
                const flags = document.getElementById('regexFlags').value;
                const button = document.getElementById('processRegexBtn');

                if (!pattern.trim()) {
                    Utils.showNotification('Regex pattern cannot be empty', 'error');
                    return;
                }

                const config = toolConfig['regex-tester'];
                if (pattern.length > config.maxPatternLength) {
                    Utils.showNotification(`Pattern too long. Maximum ${config.maxPatternLength} characters allowed.`, 'error');
                    return;
                }

                Utils.setLoading(button, true);
                await ApiService.processTool('regex-tester', {
                    input: input,
                    pattern: pattern,
                    flags: flags
                });
                Utils.setLoading(button, false);
            },

            async processYamlJsonConverter() {
                const input = document.getElementById('yamlJsonInput').value;
                const action = document.querySelector('input[name="yamlJsonAction"]:checked').value;
                const toJson = action === 'to-json';
                const button = document.getElementById('processYamlJsonBtn');

                const config = toolConfig['yaml-json-converter'];
                const error = Utils.validateInput(input, config.maxInputLength, config.requiresInput);
                if (error) {
                    Utils.showNotification(error, 'error');
                    return;
                }

                Utils.setLoading(button, true);
                await ApiService.processTool('yaml-json-converter', {
                    input: input,
                    toJson: toJson
                });
                Utils.setLoading(button, false);
            },

