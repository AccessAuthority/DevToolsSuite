                        </div>
                        <div>
                            <h5 class="fw-bold mb-1">JSON Formatter</h5>
                            <span class="badge bg-primary">Most Popular</span>
                        </div>
                    </div>
                    <p class="text-muted mb-3">Format, validate, and beautify JSON data with syntax highlighting and error detection.</p>
                    <div class="tool-features mb-3">
                        <small class="text-muted">
                            <i class="fas fa-check text-success me-1"></i>Syntax highlighting
                        </small>
                        <small class="text-muted ms-3">
                            <i class="fas fa-check text-success me-1"></i>Error detection
                        </small>
                        <small class="text-muted ms-3">
                            <i class="fas fa-check text-success me-1"></i>Minify/Beautify
                        </small>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="tool-stats">
                            <small class="text-muted">
                                <i class="fas fa-chart-line me-1"></i>15k uses today
                            </small>
                        </div>
